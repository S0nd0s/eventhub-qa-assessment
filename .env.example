# Copy to .env and fill in two accounts registered at https://eventhub.rahulshettyacademy.com/register
# (accounts that do not exist yet are registered automatically on the first run).
BASE_URL=https://eventhub.rahulshettyacademy.com
API_URL=https://api.eventhub.rahulshettyacademy.com/api

# Primary user: does the booking work.
EVENTHUB_EMAIL=
EVENTHUB_PASSWORD=

# Secondary user: "another user" in ownership tests, and the account used for visual baselines.
EVENTHUB_EMAIL_2=
EVENTHUB_PASSWORD_2=
